{
  "name": "multiplayer-browser-game-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, non-video AS3 multiplayer feasibility laboratory",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "node scripts/verify-e2e.mjs",
    "test:network": "node scripts/verify-network.mjs",
    "build:probe": "node scripts/build-as3-probe.mjs",
    "check:utf8": "python3 scripts/check_utf8.py"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "playwright": "1.62.1",
    "ws": "8.23.0"
  }
}
